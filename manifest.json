{
  "manifest_version": 2,
  "name": "Daily Site Time Tracker",
  "version": "1.1.0",
  "description": "Mide cuánto tiempo pasas en todos los sitios durante cada día.",
  "permissions": [
    "tabs",
    "storage",
    "idle"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "daily-site-time-tracker@example.local"
    }
  },
  "browser_action": {
    "default_title": "Tiempo de hoy",
    "default_popup": "popup.html"
  }
}
